# EditorConfig for from-newton-to-kerr
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yaml,yml}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break; preserve it.
[*.md]
trim_trailing_whitespace = false

# Future compatibility only. No Python file or directory is created by this task.
[*.py]
indent_size = 4
